{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp-write",
      "destination": "/api/mcp-write"
    },
    {
      "source": "/room-editor",
      "destination": "/ALBURY_ROOM_EDITOR.html"
    },
    {
      "source": "/images/albury/managed/:id([a-f0-9]{64}).webp",
      "destination": "/api/room-media?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/site/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
